From 25adb473e28663be52aa46f017f1b65de41b7b82 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Tue, 13 Oct 2026 20:48:55 +0200
Subject: [PATCH 2/3] ARM: dts: qcom: msm8960: Add IMEM reboot mode region

Describe the IMEM region and reboot reason register at offset
0x65c. Board files can supply the reboot mode values expected by
their bootloader.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 arch/arm/boot/dts/qcom/qcom-msm8960.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8960.dtsi b/arch/arm/boot/dts/qcom/qcom-msm8960.dtsi
index fd28401ce..4d1345267 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8960.dtsi
+++ b/arch/arm/boot/dts/qcom/qcom-msm8960.dtsi
@@ -804,6 +804,16 @@ lcc: clock-controller@28000000 {
 				      "spare_i2s_spkr_codec_clk",
 				      "pcm_codec_clk";
 		};
+
+		imem: sram@2a03f000 {
+			compatible = "qcom,msm8960-imem", "syscon", "simple-mfd";
+			reg = <0x2a03f000 0x1000>;
+
+			reboot-mode {
+				compatible = "syscon-reboot-mode";
+				offset = <0x65c>;
+			};
+		};
 	};
 
 	thermal-zones {
-- 
2.43.0

