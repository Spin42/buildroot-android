-			  phys_addr_t *reloc_base)
+			  phys_addr_t *reloc_base, size_t phoff, bool is_split)
 {
 	const struct elf32_phdr *phdrs;
 	const struct elf32_phdr *phdr;
@@ -344,7 +332,6 @@ int qcom_mdt_load_no_init(struct device *dev, const struct firmware *fw,
 	phys_addr_t min_addr = PHYS_ADDR_MAX;
 	ssize_t offset;
 	bool relocate = false;
-	bool is_split;
 	void *ptr;
 	int ret = 0;
 	int i;
@@ -352,12 +339,8 @@ int qcom_mdt_load_no_init(struct device *dev, const struct firmware *fw,
 	if (!fw || !mem_region || !mem_phys || !mem_size)
 		return -EINVAL;
 
-	if (!mdt_header_valid(fw))
-		return -EINVAL;
-
-	is_split = qcom_mdt_bins_are_split(fw);
