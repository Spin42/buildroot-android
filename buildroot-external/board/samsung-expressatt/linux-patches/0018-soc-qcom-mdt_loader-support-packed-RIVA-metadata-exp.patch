From dc6a312fae1b5951ead7f0a0d1f38915a49bb7f4 Mon Sep 17 00:00:00 2001
From: Express Port <expressatt@localhost>
Date: Tue, 13 Oct 2026 22:43:43 +0200
Subject: [PATCH 18/19] soc: qcom: mdt_loader: support packed RIVA metadata
 explicitly

Early RIVA MDT files keep the original ELF program-header offset while
storing the table directly after the ELF header. The downstream PIL
passes this entire packed MDT unchanged for authentication.

Provide an explicit legacy entry point for RIVA only. Bound the packed
table, hash tail, split segment numbering and every destination before
authenticating the original bytes. Reject relocatable legacy images.
Reuse the existing split segment loader while preserving validation and
dispatch for modern MDT files.

Signed-off-by: Express Port <expressatt@localhost>
---
 drivers/remoteproc/qcom_wcnss.c     |  12 ++-
 drivers/soc/qcom/mdt_loader.c       | 151 ++++++++++++++++++++++++----
 include/linux/soc/qcom/mdt_loader.h |  13 +++
 3 files changed, 153 insertions(+), 23 deletions(-)

diff --git a/drivers/remoteproc/qcom_wcnss.c b/drivers/remoteproc/qcom_wcnss.c
index 5e4a623b8..b47edf8dc 100644
--- a/drivers/remoteproc/qcom_wcnss.c
+++ b/drivers/remoteproc/qcom_wcnss.c
@@ -157,9 +157,15 @@ static int wcnss_load(struct rproc *rproc, const struct firmware *fw)
 	struct qcom_wcnss *wcnss = rproc->priv;
 	int ret;
 
-	ret = qcom_mdt_load(wcnss->dev, fw, rproc->firmware, WCNSS_PAS_ID,
-			    wcnss->mem_region, wcnss->mem_phys,
-			    wcnss->mem_size, &wcnss->mem_reloc);
+	if (of_device_is_compatible(wcnss->dev->of_node, "qcom,riva-pil"))
+		ret = qcom_mdt_load_legacy(wcnss->dev, fw, rproc->firmware,
+					   WCNSS_PAS_ID, wcnss->mem_region,
+					   wcnss->mem_phys, wcnss->mem_size,
+					   &wcnss->mem_reloc);
+	else
+		ret = qcom_mdt_load(wcnss->dev, fw, rproc->firmware, WCNSS_PAS_ID,
+				    wcnss->mem_region, wcnss->mem_phys,
+				    wcnss->mem_size, &wcnss->mem_reloc);
 	if (ret)
 		return ret;
 
