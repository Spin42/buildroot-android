From b0eaf9e3967f7a891bb66d5ec887ed35262d6540 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Tue, 13 Oct 2026 21:58:56 +0200
Subject: [PATCH 11/13] dt-bindings: power: supply: bq2415x: Allow disabling
 termination

Document an optional board policy to disable current-based charge
termination. Existing boards retain the current default behavior.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 Documentation/devicetree/bindings/power/supply/bq2415x.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/supply/bq2415x.yaml b/Documentation/devicetree/bindings/power/supply/bq2415x.yaml
index 9ef801a85..17c30f370 100644
--- a/Documentation/devicetree/bindings/power/supply/bq2415x.yaml
+++ b/Documentation/devicetree/bindings/power/supply/bq2415x.yaml
@@ -60,6 +60,12 @@ properties:
     $ref: /schemas/types.yaml#/definitions/uint32
     description: value of sensing resistor in milliohm.
 
+  ti,disable-charge-termination:
+    type: boolean
+    description: |
+      Disable charge-current-based termination when configuring the charger.
+      If absent, termination is enabled when a sense resistor is specified.
+
   ti,usb-charger-detection:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: phandle to usb charger detection device (required for auto mode)
-- 
