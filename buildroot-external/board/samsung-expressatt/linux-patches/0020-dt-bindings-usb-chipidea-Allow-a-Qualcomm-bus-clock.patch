From 9dd06996124e8c1f9d5ed1f28124e1991eba130f Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Tue, 13 Oct 2026 23:07:40 +0200
Subject: [PATCH 20/22] dt-bindings: usb: chipidea: Allow a Qualcomm bus clock

The MSM8960 controller needs a fabric clock vote in addition to the
functional core and interface clocks. Allow an optional bus clock,
with or without the existing optional full-speed clock.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 Documentation/devicetree/bindings/usb/ci-hdrc-usb2.yaml | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/ci-hdrc-usb2.yaml b/Documentation/devicetree/bindings/usb/ci-hdrc-usb2.yaml
index 620b56491..7b82023c3 100644
--- a/Documentation/devicetree/bindings/usb/ci-hdrc-usb2.yaml
+++ b/Documentation/devicetree/bindings/usb/ci-hdrc-usb2.yaml
@@ -45,11 +45,11 @@ properties:
 
   clocks:
     minItems: 1
-    maxItems: 3
+    maxItems: 4
 
   clock-names:
     minItems: 1
-    maxItems: 3
+    maxItems: 4
 
   operating-points-v2:
     description: A phandle to the OPP table containing the performance states.
@@ -103,10 +103,12 @@ allOf:
           minItems: 2
         clock-names:
           minItems: 2
+          uniqueItems: true
           items:
             - const: iface
             - const: core
-            - const: fs
+            - enum: [fs, bus]
+            - const: bus
     else:
       properties:
         clocks:
-- 
2.43.0

