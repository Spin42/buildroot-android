# BusyBox init for the persistent system.
# The kernel mounts the root filesystem read-only (ro on the command line): rootfs-check runs
# e2fsck on it before remounting it read-write, since ext2 has no journal.

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/usr/sbin/rootfs-check
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys /run/s3ve3g
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Root shell on the USB serial port (ttyGS0) once the gadget exists.
::respawn:/usr/sbin/ttygs0-console

::ctrlaltdel:/sbin/reboot

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
