 	chosen {
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -194,6 +251,13 @@ reboot-mode {
 	};
 };
 
+&pm8226_bms {
+	monitored-battery = <&battery>;
+	shunt-resistor-micro-ohms = <10000>;
+
+	status = "okay";
