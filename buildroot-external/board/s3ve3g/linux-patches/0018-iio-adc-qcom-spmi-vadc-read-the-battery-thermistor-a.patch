From 393b45a2024befa9b545ffada1b65459be680f25 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Tue, 4 Aug 2026 09:56:19 +0200
Subject: [PATCH 18/26] iio: adc: qcom-spmi-vadc: read the battery thermistor
 as a temperature

The LR_MUX1_BAT_THERM channel was declared without scaling, so the
battery thermistor was only available as a raw voltage and nothing could
act on battery temperature.  That matters beyond reporting: on PM8941
battery presence detection is wired to this same thermistor line, and
the charger needs the temperature to apply the JEITA voltage and current
derating that the vendor driver applies.

The thermistor needs its own mapping.  The downstream driver selects
SCALE_BATT_THERM (qcom,scale-function = <1>) for batt_therm channels,
not the 100k pullup table that this driver already carries, and reads
the channel ratiometrically against VDD_VADC.  Port that table verbatim
from qpnp-adc-common.c adcmap_btm_threshold[] (converting its
decidegC/mV pairs to the mV/millidegC form used here; 83 points,
-30..79 C, round-trip checked against the source), add the matching
scale function, and declare the channel as a ratiometric temperature
channel.

Assisted-by: Claude:claude-fable-5
---
 arch/arm/boot/dts/qcom/pm8941.dtsi       |   8 ++
 drivers/iio/adc/qcom-spmi-vadc.c         |   2 +-
 drivers/iio/adc/qcom-vadc-common.c       | 115 +++++++++++++++++++++++
 include/linux/iio/adc/qcom-vadc-common.h |   3 +
 4 files changed, 127 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/qcom/pm8941.dtsi b/arch/arm/boot/dts/qcom/pm8941.dtsi
index aca0052a02b7..d2309357c7e0 100644
--- a/arch/arm/boot/dts/qcom/pm8941.dtsi
+++ b/arch/arm/boot/dts/qcom/pm8941.dtsi
@@ -173,6 +173,14 @@ channel@f {
 
 			channel@30 {
 				reg = <VADC_LR_MUX1_BAT_THERM>;
+				/*
+				 * The battery thermistor is read against
+				 * VDD_VADC, as the vendor configuration does
+				 * (calibration-type "ratiometric"); the
+				 * mapping table is expressed in those terms.
+				 */
+				qcom,ratiometric;
+				qcom,hw-settle-time = <200>;
 			};
 		};
 
diff --git a/drivers/iio/adc/qcom-spmi-vadc.c b/drivers/iio/adc/qcom-spmi-vadc.c
index 54b8d4267120..5c43935b4585 100644
--- a/drivers/iio/adc/qcom-spmi-vadc.c
+++ b/drivers/iio/adc/qcom-spmi-vadc.c
@@ -609,7 +609,7 @@ static const struct vadc_channels vadc_chans[] = {
 	VADC_CHAN_NO_SCALE(P_MUX15_1_3, 1)
 	VADC_CHAN_NO_SCALE(P_MUX16_1_3, 1)
 
-	VADC_CHAN_NO_SCALE(LR_MUX1_BAT_THERM, 0)
+	VADC_CHAN_TEMP(LR_MUX1_BAT_THERM, 0, SCALE_BATT_THERM)
 	VADC_CHAN_VOLT(LR_MUX2_BAT_ID, 0, SCALE_DEFAULT)
 	VADC_CHAN_NO_SCALE(LR_MUX3_XO_THERM, 0)
 	VADC_CHAN_NO_SCALE(LR_MUX4_AMUX_THM1, 0)
diff --git a/drivers/iio/adc/qcom-vadc-common.c b/drivers/iio/adc/qcom-vadc-common.c
index d5209f32adb3..03bbf2a05db2 100644
--- a/drivers/iio/adc/qcom-vadc-common.c
+++ b/drivers/iio/adc/qcom-vadc-common.c
@@ -21,6 +21,100 @@ struct vadc_map_pt {
 	s32 y;
 };
 
+/*
+ * Battery thermistor, ratiometric against VDD_VADC.  Ported verbatim from
+ * the downstream qpnp-adc-common.c adcmap_btm_threshold[] table (converted
+ * from decidegC/mV to the mV/millidegC form used here).  This is the table
+ * the vendor driver selects for the batt_therm channel on PM8941 boards
+ * (qcom,scale-function = <1>, SCALE_BATT_THERM); the 100k pullup table used
+ * for other thermistors gives wrong readings for it.
+ */
+static const struct vadc_map_pt adcmap_batt_therm_qrd[] = {
+	{ 1719,  -30000 },
+	{ 1628,  -20000 },
+	{ 1506,  -10000 },
+	{ 1355,       0 },
