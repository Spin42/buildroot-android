new file mode 100644
index 00000000000..dac4be0c2bb
--- /dev/null
+++ b/board/lenovo/tb3-710f/tb3-710f.c
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lenovo Tab3 7 Essential (TB3-710F) board support.
+ *
+ * LK, the vendor bootloader, picks its boot mode from the MT6323 RTC
+ * power-down register PDN1: bit 13 selects fastboot, bit 4 (with bit 5
+ * clear) selects recovery. LK clears bit 13 when it enters fastboot and
+ * leaves bit 4 set when it boots recovery. The register survives a
+ * watchdog reset.
+ *
+ * Boot-once guard: U-Boot sets the recovery bit as soon as it starts and
+ * clears it just before jumping to Linux. If U-Boot hangs, the watchdog
+ * resets the SoC and LK boots the recovery image instead of U-Boot again.
+ *
+ * U-Boot also copies its console output to 0xbfd00000, the last MiB of
+ * the 16 MiB LK video memory, which Linux reserves and does not touch, so
+ * the log of the U-Boot run that started Linux can be read with /dev/mem.
+ * LK clears that memory at boot: the log does not survive a reset.
+ *
+ * Keys at start: Volume-Down (or "fastboot reboot-bootloader") stays in
+ * U-Boot fastboot, Volume-Up reboots into recovery. The keys are on the
+ * keypad columns KCOL0 (Volume-Up, GPIO36) and KCOL1 (Volume-Down, GPIO37),
+ * which LK leaves in keypad mode with pull-ups: the pad input reads 0 while
+ * a key is held.
+ *
+ * The PMIC is reached through the PMIC wrapper (pwrap) WACS2 channel, which
+ * the preloader has already initialised.
+ */
+
+#include <command.h>
+#include <console.h>
+#include <env.h>
+#include <fastboot.h>
+#include <dm.h>
+#include <mmc.h>
+#include <usb.h>
+#include <asm/global_data.h>
+#include <stdio_dev.h>
+#include <init.h>
+#include <time.h>
+#include <asm/processor.h>
+#include <linux/delay.h>
+#include <asm/io.h>
+#include <asm/cache.h>
+#include <asm/system.h>
+#include <cpu_func.h>
+#include <linux/sizes.h>
+#include <image.h>
+#include <version_string.h>
+
+#define TB3_FB_BASE		0xbee00000
+#define TB3_FB_SIZE		SZ_2M
+
+#define PWRAP_BASE		0x1000d000
+#define PWRAP_WACS2_CMD		(PWRAP_BASE + 0x9c)
+#define PWRAP_WACS2_RDATA	(PWRAP_BASE + 0xa0)
+#define PWRAP_WACS2_VLDCLR	(PWRAP_BASE + 0xa4)
+#define PWRAP_CMD_WRITE		BIT(31)
+#define PWRAP_STATE(rdata)	(((rdata) >> 16) & 7)
+#define PWRAP_STATE_IDLE	0
+#define PWRAP_STATE_WFVLDCLR	6
+#define PWRAP_POLL_LOOPS	1000000
+
+#define MT6323_RTC_BBPU		0x8000
+#define RTC_BBPU_CBUSY		BIT(6)
+#define MT6323_RTC_PDN1		0x802c
+#define MT6323_RTC_PROT		0x8036
+#define MT6323_RTC_WRTGR	0x803c
+#define RTC_PROT_UNLOCK1	0x586a
+#define RTC_PROT_UNLOCK2	0x9136
+
+#define PDN1_RECOVERY_MASK	(3 << 4)
+#define PDN1_RECOVERY		BIT(4)
+#define PDN1_FASTBOOT		BIT(13)
+
+#define TB3_LOG_BASE		0xbfd00000
+#define TB3_LOG_SIZE		SZ_64K
+#define TB3_LOG_MAGIC		0x4c334254	/* "TB3L" */
+
+struct tb3_log {
+	u32 magic;
+	u32 stage;	/* last board hook reached, see tb3_stage() */
+	u32 len;	/* bytes of text, the text is not wrapped */
+	u32 reserved;
+	char text[];
+};
+
+#define TB3_LOG_TEXT_MAX	(TB3_LOG_SIZE - sizeof(struct tb3_log))
+
+#define MT8127_GPIO_DIN2	0x10005520	/* GPIO32..47 input level */
+#define TB3_KEY_VOLUP		BIT(36 - 32)
+#define TB3_KEY_VOLDOWN		BIT(37 - 32)
+#define TB3_KEY_WINDOW_MS	2000
+
+/*
+ * "fastboot reboot-bootloader" flag: DRAM keeps it across the watchdog
+ * reset and LK does not touch this word, in the CONSYS area U-Boot does not
+ * otherwise use.
+ */
+#define TB3_REBOOT_FLAG		0xbc0ffff8
+#define TB3_REBOOT_FASTBOOT	0x55424642	/* "BFBU" */
+
+#define TB3_ATAGS_ADDR		0x80000100
+
+DECLARE_GLOBAL_DATA_PTR;
+
+enum tb3_bootmode {
+	TB3_BOOT_NORMAL,
+	TB3_BOOT_RECOVERY,
+	TB3_BOOT_FASTBOOT,
+};
+
+/* Written before relocation, when .bss is not usable yet. */
+static int guard_status __section(".data");
+static u16 guard_pdn1 __section(".data");
+
+static int pwrap_wait(int state)
+{
+	int i;
+
+	for (i = 0; i < PWRAP_POLL_LOOPS; i++)
+		if (PWRAP_STATE(readl(PWRAP_WACS2_RDATA)) == state)
+			return 0;
+
+	return -ETIMEDOUT;
+}
+
+static int pmic_read(u32 reg, u16 *val)
+{
+	if (pwrap_wait(PWRAP_STATE_IDLE))
+		return -ETIMEDOUT;
+	writel((reg >> 1) << 16, PWRAP_WACS2_CMD);
+	if (pwrap_wait(PWRAP_STATE_WFVLDCLR))
+		return -ETIMEDOUT;
+	*val = readl(PWRAP_WACS2_RDATA) & 0xffff;
+	writel(1, PWRAP_WACS2_VLDCLR);
+
+	return 0;
+}
+
+static int pmic_write(u32 reg, u16 val)
+{
+	if (pwrap_wait(PWRAP_STATE_IDLE))
+		return -ETIMEDOUT;
+	writel(PWRAP_CMD_WRITE | ((reg >> 1) << 16) | val, PWRAP_WACS2_CMD);
+
+	return 0;
+}
+
+/* Commit the RTC shadow registers to the RTC domain. */
+static int rtc_write_trigger(void)
+{
+	u16 bbpu;
+	int i;
+
+	if (pmic_write(MT6323_RTC_WRTGR, 1))
+		return -ETIMEDOUT;
+	for (i = 0; i < 100000; i++) {
+		if (pmic_read(MT6323_RTC_BBPU, &bbpu))
+			return -ETIMEDOUT;
+		if (!(bbpu & RTC_BBPU_CBUSY))
+			return 0;
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int rtc_unlock(void)
+{
+	if (pmic_write(MT6323_RTC_PROT, RTC_PROT_UNLOCK1) || rtc_write_trigger())
+		return -ETIMEDOUT;
+	if (pmic_write(MT6323_RTC_PROT, RTC_PROT_UNLOCK2) || rtc_write_trigger())
+		return -ETIMEDOUT;
+
+	return 0;
+}
+
+static int tb3_set_bootmode(enum tb3_bootmode mode, u16 *pdn1_out)
+{
+	u16 pdn1;
+	int ret;
+
+	ret = rtc_unlock();
+	if (!ret)
+		ret = pmic_read(MT6323_RTC_PDN1, &pdn1);
+	if (ret)
+		return ret;
+
+	pdn1 &= ~(PDN1_RECOVERY_MASK | PDN1_FASTBOOT);
+	if (mode == TB3_BOOT_RECOVERY)
+		pdn1 |= PDN1_RECOVERY;
+	else if (mode == TB3_BOOT_FASTBOOT)
+		pdn1 |= PDN1_FASTBOOT;
+
+	ret = pmic_write(MT6323_RTC_PDN1, pdn1);
+	if (!ret)
+		ret = rtc_write_trigger();
+	if (!ret)
+		ret = pmic_read(MT6323_RTC_PDN1, &pdn1);
+	if (!ret && pdn1_out)
+		*pdn1_out = pdn1;
+
+	return ret;
+}
+
+static struct tb3_log *tb3_log(void)
+{
+	return (struct tb3_log *)TB3_LOG_BASE;
+}
+
+static void tb3_stage(u32 stage)
+{
+	tb3_log()->stage = stage;
+	flush_dcache_range(TB3_LOG_BASE, TB3_LOG_BASE + ARCH_DMA_MINALIGN);
+}
+
+static void tb3_log_putc(struct stdio_dev *dev, const char c)
+{
+	struct tb3_log *log = tb3_log();
+
+	if (log->len >= TB3_LOG_TEXT_MAX)
+		return;
+	log->text[log->len++] = c;
+}
+
+static void tb3_log_puts(struct stdio_dev *dev, const char *s)
+{
+	while (*s)
+		tb3_log_putc(dev, *s++);
+}
+
+int board_early_init_f(void)
+{
+	struct tb3_log *log = tb3_log();
+
+	/* Arm the boot-once guard before anything else can hang. */
+	guard_status = tb3_set_bootmode(TB3_BOOT_RECOVERY, &guard_pdn1);
+
+	/* Caches are off here: plain stores reach DRAM. */
+	log->magic = TB3_LOG_MAGIC;
+	log->len = 0;
+	log->stage = 1;
+
+	return 0;
+}
+
+int board_early_init_r(void)
+{
+	struct stdio_dev dev = {
+		.name = "memlog",
+		.flags = DEV_FLAGS_OUTPUT,
+		.putc = tb3_log_putc,
+		.puts = tb3_log_puts,
+	};
+
+	tb3_stage(3);
+
+	return stdio_register(&dev);
+}
+
+int board_init(void)
+{
+	/*
+	 * The framebuffer lies outside the DRAM bank U-Boot maps, so it would
+	 * be strongly ordered; write-through keeps the scanout coherent and
+	 * makes console scrolling usable.
+	 */
+	mmu_set_region_dcache_behaviour(TB3_FB_BASE, TB3_FB_SIZE,
+					DCACHE_WRITETHROUGH);
+	/* The log must reach DRAM even if U-Boot hangs right after a write. */
+	mmu_set_region_dcache_behaviour(ALIGN_DOWN(TB3_LOG_BASE, SZ_1M), SZ_1M,
+					DCACHE_WRITETHROUGH);
+	tb3_stage(2);
+
+	/* ATAGs for "fastboot boot" of an Android image without a DTB */
+	gd->bd->bi_boot_params = TB3_ATAGS_ADDR;
+
+	return 0;
+}
+
+static u32 tb3_keys(void)
+{
+	u32 din = readl(MT8127_GPIO_DIN2);
+
+	return ~din & (TB3_KEY_VOLUP | TB3_KEY_VOLDOWN);
+}
+
+static bool tb3_take_reboot_flag(void)
+{
+	u32 *flag = (u32 *)TB3_REBOOT_FLAG;
+	bool set = *flag == TB3_REBOOT_FASTBOOT;
+
+	*flag = 0;
+	flush_dcache_range(ALIGN_DOWN(TB3_REBOOT_FLAG, ARCH_DMA_MINALIGN),
+			   ALIGN(TB3_REBOOT_FLAG + 4, ARCH_DMA_MINALIGN));
+
+	return set;
+}
+
+int fastboot_set_reboot_flag(enum fastboot_reboot_reason reason)
+{
+	u32 *flag = (u32 *)TB3_REBOOT_FLAG;
+
+	switch (reason) {
+	case FASTBOOT_REBOOT_REASON_BOOTLOADER:
+		*flag = TB3_REBOOT_FASTBOOT;
+		flush_dcache_range(ALIGN_DOWN(TB3_REBOOT_FLAG, ARCH_DMA_MINALIGN),
+				   ALIGN(TB3_REBOOT_FLAG + 4, ARCH_DMA_MINALIGN));
+		return 0;
+	case FASTBOOT_REBOOT_REASON_RECOVERY:
+		return tb3_set_bootmode(TB3_BOOT_RECOVERY, NULL);
+	case FASTBOOT_REBOOT_REASON_FASTBOOTD:
+		/* LK's own fastboot */
+		return tb3_set_bootmode(TB3_BOOT_FASTBOOT, NULL);
+	default:
+		return -EINVAL;
+	}
+}
+
+/* Probing the MUSB glue registers it as the gadget controller. */
+int board_usb_init(int index, enum usb_init_type init)
+{
+	struct udevice *dev;
+
+	return uclass_get_device(UCLASS_USB_GADGET_GENERIC, index, &dev);
+}
+
+/* serial# for fastboot, from the eMMC product serial number in the CID */
+static void tb3_set_serial(void)
+{
+	struct mmc *mmc = find_mmc_device(0);
+	char serial[20];
+
+	if (!mmc || mmc_init(mmc))
+		return;
+	snprintf(serial, sizeof(serial), "TB3UB%04x%04x",
+		 mmc->cid[2] & 0xffff, mmc->cid[3] >> 16);
+	env_set("serial#", serial);
+}
+
+int board_late_init(void)
+{
+	u64 t0;
+	u32 keys;
+	ulong start;
+	int i;
+
+	tb3_stage(4);
+	printf("\n%s\n", version_string);
+	printf("Lenovo TB3-710F, chainloaded by LK\n");
+	/* A busy loop, not udelay(): it would never return if the counter stopped. */
+	t0 = get_ticks();
+	for (i = 0; i < 100000; i++)
+		cpu_relax();
+	printf("Timer: arch counter at %lu Hz, %s\n", get_tbclk(),
+	       get_ticks() != t0 ? "running" : "STOPPED");
+	if (guard_status)
+		printf("Boot-once guard: PMIC access failed (%d)\n", guard_status);
+	else
+		printf("Boot-once guard: armed (RTC PDN1 0x%04x, recovery on reset)\n",
+		       guard_pdn1);
+
+	if (IS_ENABLED(CONFIG_CONSOLE_RECORD))
+		console_record_reset_enable();
+
+	tb3_set_serial();
+	env_set("fastboot.uboot-log", "fastboot oem console");
+
+	/* Give the user a window to press a key: LK hands over quickly. */
+	printf("Hold Volume-Down for fastboot, Volume-Up for recovery...\n");
+	start = get_timer(0);
+	do {
+		keys = tb3_keys();
+		if (keys)
+			break;
+		mdelay(20);
+	} while (get_timer(start) < TB3_KEY_WINDOW_MS);
+	env_set("fastboot.keys", keys & TB3_KEY_VOLDOWN ? "volume-down" :
+		keys & TB3_KEY_VOLUP ? "volume-up" : "none");
+
+	if (keys & TB3_KEY_VOLUP) {
+		printf("Volume-Up held: rebooting into recovery\n");
+		tb3_set_bootmode(TB3_BOOT_RECOVERY, NULL);
+		mdelay(1000);
+		do_reset(NULL, 0, 0, NULL);
+	}
+
+	if (tb3_take_reboot_flag()) {
+		env_set("tb3_mode", "fastboot");
+		env_set("fastboot.boot_path", "reboot-bootloader");
+	} else if (keys & TB3_KEY_VOLDOWN) {
+		env_set("tb3_mode", "fastboot");
+		env_set("fastboot.boot_path", "volume-down");
+	}
+
+	return 0;
+}
+
+void board_prep_linux(struct bootm_headers *images)
+{
+	u16 pdn1;
+
+	tb3_stage(5);
+
+	if (tb3_set_bootmode(TB3_BOOT_NORMAL, &pdn1))
+		printf("Boot-once guard: failed to disarm\n");
+	else
+		printf("Boot-once guard: disarmed (RTC PDN1 0x%04x)\n", pdn1);
+}
+
+static int do_tb3_bootmode(struct cmd_tbl *cmdtp, int flag, int argc,
+			   char *const argv[])
+{
+	enum tb3_bootmode mode;
+	u16 pdn1;
+
+	if (argc < 2) {
+		if (rtc_unlock() || pmic_read(MT6323_RTC_PDN1, &pdn1))
+			return CMD_RET_FAILURE;
+		printf("RTC PDN1 0x%04x: %s\n", pdn1,
+		       pdn1 & PDN1_FASTBOOT ? "fastboot" :
+		       (pdn1 & PDN1_RECOVERY_MASK) == PDN1_RECOVERY ?
+		       "recovery" : "normal");
+		return CMD_RET_SUCCESS;
+	}
+
+	if (!strcmp(argv[1], "normal"))
+		mode = TB3_BOOT_NORMAL;
+	else if (!strcmp(argv[1], "recovery"))
+		mode = TB3_BOOT_RECOVERY;
+	else if (!strcmp(argv[1], "fastboot") || !strcmp(argv[1], "bootloader"))
+		mode = TB3_BOOT_FASTBOOT;
+	else
+		return CMD_RET_USAGE;
+
+	if (tb3_set_bootmode(mode, &pdn1)) {
+		printf("PMIC access failed\n");
+		return CMD_RET_FAILURE;
+	}
+	printf("RTC PDN1 0x%04x: LK boots %s on the next reset\n", pdn1, argv[1]);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(bootmode, 2, 0, do_tb3_bootmode,
+	   "select the boot mode of the vendor bootloader (LK)",
+	   "[normal|recovery|fastboot]\n"
+	   "  - without argument, show the current mode");
diff --git a/board/lenovo/tb3-710f/tb3-710f.env b/board/lenovo/tb3-710f/tb3-710f.env
new file mode 100644
index 00000000000..76a39f5b545
--- /dev/null
+++ b/board/lenovo/tb3-710f/tb3-710f.env
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+stdin=nulldev
+stdout=vidconsole,memlog
+stderr=vidconsole,memlog
+
+/* 0x80002000 is the TEE boot-info page, 0x80008000 the kernel text */
+kernel_addr_r=0x80800000
+pxefile_addr_r=0x83d00000
+scriptaddr=0x83e00000
+fdt_addr_r=0x83f00000
+ramdisk_addr_r=0x84000000
+/* FDT and initrd are relocated below this, inside Linux lowmem */
+bootm_size=0x10000000
+
+/*
+ * Boot order:
+ * 1. Nerves: userdata (mmcblk0p7) holds a disk image with its own MBR;
+ *    partition 1 is the active FAT boot slot with /extlinux/extlinux.conf.
+ *    fwup switches slots by rewriting that MBR, so no environment is saved.
+ * 2. Buildroot: an ext4 root on userdata with /boot/extlinux/extlinux.conf.
+ * 3. Neither: LK fastboot on the next boot.
+ * Never save the environment: it would land in userdata.
+ */
+bootif=mmc
+bootdevnum=0
+/* userdata start and the end of the Nerves layout (before the BMT pool), in 512-byte blocks */
+userdata_start=4608000
+nerves_blocks=10618880
+nerves_extlinux=/extlinux/extlinux.conf
+bootpart=7
+extlinux=/boot/extlinux/extlinux.conf
+
+nerves_map=blkmap create nerves && blkmap map nerves 0 ${nerves_blocks}
+	linear ${bootif} ${bootdevnum} ${userdata_start} &&
+	blkmap get nerves dev nerves_dev
+boot_nerves=if test -e blkmap ${nerves_dev}:1 ${nerves_extlinux}; then
+	echo == Booting Nerves: ${nerves_extlinux} in the userdata image, partition 1;
+	sysboot blkmap ${nerves_dev}:1 any ${scriptaddr} ${nerves_extlinux}; fi
+boot_buildroot=if test -e ${bootif} ${bootdevnum}:${bootpart} ${extlinux}; then
+	echo == Booting Buildroot: ${extlinux} on ${bootif} ${bootdevnum}:${bootpart};
+	sysboot ${bootif} ${bootdevnum}:${bootpart} any ${scriptaddr} ${extlinux}; fi
+boot_failed=echo == Nothing to boot;
+	setenv fastboot.boot_path nothing-bootable; run fastboot_mode; reset
+
+/*
+ * U-Boot fastboot over USB. Only "boot" (the Android boot image region,
+ * where this U-Boot lives) and "userdata" (up to the BMT pool) can be
+ * flashed or erased. The boot-once guard is off while waiting; it is set
+ * again when fastboot ends with "continue".
+ */
+board=tb3-710f-uboot
+fastboot_raw_partition_boot=0xec00 0x8000
+fastboot_raw_partition_userdata=0x465000 0xa21a00
+fastboot_mode=bootmode normal;
+	echo; echo ======== U-Boot fastboot mode (${fastboot.boot_path}) ========;
+	echo fastboot -s ${serial#} getvar product = ${board};
+	echo flash boot / userdata, boot, oem console, continue, reboot;
+	echo reboot-bootloader: here again, reboot-recovery: TWRP, reboot-fastboot: LK fastboot;
+	fastboot usb 0; bootmode recovery
+
+bootcmd=if test "${tb3_mode}" = fastboot; then run fastboot_mode; fi;
+	run nerves_map; run boot_nerves; run boot_buildroot; run boot_failed
