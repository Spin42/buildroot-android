From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Mon, 12 Oct 2026 15:08:24 +0200
Subject: [PATCH 13/17] button: gpio: support debounce-interval

Honour the gpio-keys debounce-interval property: a new level is
reported once it has been read unchanged for that long. Without the
property the level is reported as read, as before.

A bouncing key otherwise turns one press into several bootmenu moves
through button_kbd.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/button/button-gpio.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/drivers/button/button-gpio.c b/drivers/button/button-gpio.c
index 31b85c8150e..0661c9dbd26 100644
--- a/drivers/button/button-gpio.c
+++ b/drivers/button/button-gpio.c
@@ -8,11 +8,26 @@
 #include <dm/lists.h>
 #include <dm/uclass-internal.h>
 #include <log.h>
+#include <time.h>
 #include <asm/gpio.h>
 
+/**
+ * struct button_gpio_priv - private data of a GPIO button
+ *
+ * @gpio:	GPIO of the button
+ * @linux_code:	Linux input event code
+ * @debounce_ms: time a new level must hold before it is reported, 0 for none
+ * @level:	last level read
+ * @changed:	time of the last level change
+ * @state:	reported (debounced) level
+ */
 struct button_gpio_priv {
 	struct gpio_desc gpio;
 	int linux_code;
+	u32 debounce_ms;
+	int level;
+	ulong changed;
+	int state;
 };
 
 static enum button_state_t button_gpio_get_state(struct udevice *dev)
@@ -29,6 +44,16 @@ static enum button_state_t button_gpio_get_state(struct udevice *dev)
 	if (ret < 0)
 		return ret;
 
+	if (priv->debounce_ms) {
+		if (ret != priv->level) {
+			priv->level = ret;
+			priv->changed = get_timer(0);
+		} else if (get_timer(priv->changed) >= priv->debounce_ms) {
+			priv->state = ret;
+		}
+		ret = priv->state;
+	}
+
 	return ret ? BUTTON_ON : BUTTON_OFF;
 }
 
@@ -59,6 +84,16 @@ static int button_gpio_probe(struct udevice *dev)
 	if (ret || !dm_gpio_is_valid(&priv->gpio))
 		return ret;
 
+	priv->debounce_ms = dev_read_u32_default(dev, "debounce-interval", 0);
+	if (priv->debounce_ms) {
+		ret = dm_gpio_get_value(&priv->gpio);
+		if (ret < 0)
+			return ret;
+		priv->level = ret;
+		priv->state = ret;
+		priv->changed = get_timer(0);
+	}
+
 	ret = dev_read_u32(dev, "linux,code", &priv->linux_code);
 
 	return ret;
