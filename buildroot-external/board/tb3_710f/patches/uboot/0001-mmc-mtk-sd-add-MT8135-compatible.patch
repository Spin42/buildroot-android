From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Mon, 12 Oct 2026 11:33:33 +0200
Subject: [PATCH 1/4] mmc: mtk-sd: add MT8135 compatible

MT8135-class controllers (also used in MT8127) have an 8-bit clock
divider and none of the newer tuning, async FIFO or busy-check features,
like the Linux mt8135 compatible data.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/mmc/mtk-sd.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/mmc/mtk-sd.c b/drivers/mmc/mtk-sd.c
index 51c9c0a3fad..0514aff714f 100644
--- a/drivers/mmc/mtk-sd.c
+++ b/drivers/mmc/mtk-sd.c
@@ -1920,6 +1920,16 @@ static const struct msdc_compatible mt7623_compat = {
 	.enhance_rx = false,
 };
 
+static const struct msdc_compatible mt8135_compat = {
+	.clk_div_bits = 8,
+	.pad_tune0 = false,
+	.async_fifo = false,
+	.data_tune = false,
+	.busy_check = false,
+	.stop_clk_fix = false,
+	.enhance_rx = false,
+};
+
 static const struct msdc_compatible mt7986_compat = {
 	.clk_div_bits = 12,
 	.pad_tune0 = true,
@@ -1996,6 +2006,7 @@ static const struct udevice_id msdc_ids[] = {
 	{ .compatible = "mediatek,mt7621-mmc", .data = (ulong)&mt7621_compat },
 	{ .compatible = "mediatek,mt7622-mmc", .data = (ulong)&mt7622_compat },
 	{ .compatible = "mediatek,mt7623-mmc", .data = (ulong)&mt7623_compat },
+	{ .compatible = "mediatek,mt8135-mmc", .data = (ulong)&mt8135_compat },
 	{ .compatible = "mediatek,mt7986-mmc", .data = (ulong)&mt7986_compat },
 	{ .compatible = "mediatek,mt7987-mmc", .data = (ulong)&mt7987_compat },
 	{ .compatible = "mediatek,mt7981-mmc", .data = (ulong)&mt7981_compat },
