+/* One field per pin, 16 pins per register */
+#define PIN_FIELD(_s_pin, _e_pin, _s_addr, _x_addrs, _s_bit, _x_bits)	\
+	PIN_FIELD_CALC(_s_pin, _e_pin, _s_addr, _x_addrs, _s_bit,	\
+		       _x_bits, 16, false)
+
+/* One field shared by all the pins of the range */
+#define PIN_FIELD_FIXED(_s_pin, _e_pin, _addr, _bit, _x_bits)		\
+	PIN_FIELD_CALC(_s_pin, _e_pin, _addr, 0x10, _bit, _x_bits, 32, true)
+
