From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Mon, 12 Oct 2026 13:36:29 +0200
Subject: [PATCH 8/8] board: lenovo: tb3-710f: add a boot menu and a USB disk
 mode

Holding Volume-Down during the 3 s window at start opens a menu driven
by the volume keys and the power key: fastboot, userdata as a USB disk,
recovery, LK fastboot or continue booting. The USB disk exposes only
userdata up to the BMT pool, so a host can write a Nerves image with
fwup. "fastboot oem board:ums" switches from fastboot to that mode, and
the power key, read as Ctrl-C, leaves either mode.

Assisted-by: Claude:claude-opus-5-5
---
 board/lenovo/tb3-710f/tb3-710f.c   | 188 ++++++++++++++++++++++++++++-
 board/lenovo/tb3-710f/tb3-710f.env |  28 ++++-
 configs/mt8127_tb3_710f_defconfig  |   3 +
 3 files changed, 210 insertions(+), 9 deletions(-)

diff --git a/board/lenovo/tb3-710f/tb3-710f.c b/board/lenovo/tb3-710f/tb3-710f.c
index dac4be0c2bb..61938a7c622 100644
--- a/board/lenovo/tb3-710f/tb3-710f.c
+++ b/board/lenovo/tb3-710f/tb3-710f.c
@@ -34,6 +34,9 @@
 #include <dm.h>
 #include <mmc.h>
 #include <usb.h>
+#include <cyclic.h>
+#include <g_dnl.h>
+#include <linux/usb/ch9.h>
 #include <asm/global_data.h>
 #include <stdio_dev.h>
 #include <init.h>
@@ -90,7 +93,11 @@ struct tb3_log {
 #define MT8127_GPIO_DIN2	0x10005520	/* GPIO32..47 input level */
 #define TB3_KEY_VOLUP		BIT(36 - 32)
 #define TB3_KEY_VOLDOWN		BIT(37 - 32)
-#define TB3_KEY_WINDOW_MS	2000
+#define TB3_KEY_WINDOW_MS	3000
+
+/* MT6323 CHRSTATUS: PWRKEY_DEB reads 0 while the power key is held */
+#define MT6323_CHRSTATUS	0x0142
+#define MT6323_PWRKEY_DEB	BIT(1)
 
 /*
  * "fastboot reboot-bootloader" flag: DRAM keeps it across the watchdog
@@ -244,6 +251,9 @@ int board_early_init_f(void)
 	return 0;
 }
 
+static int tb3keys_tstc(struct stdio_dev *dev);
+static int tb3keys_getc(struct stdio_dev *dev);
+
 int board_early_init_r(void)
 {
 	struct stdio_dev dev = {
@@ -253,9 +263,21 @@ int board_early_init_r(void)
 		.puts = tb3_log_puts,
 	};
 
+	struct stdio_dev keys = {
+		.name = "tb3keys",
+		.flags = DEV_FLAGS_INPUT,
+		.tstc = tb3keys_tstc,
+		.getc = tb3keys_getc,
+	};
+	int ret;
+
 	tb3_stage(3);
 
-	return stdio_register(&dev);
+	ret = stdio_register(&dev);
+	if (!ret)
+		ret = stdio_register(&keys);
+
+	return ret;
 }
 
 int board_init(void)
@@ -285,6 +307,45 @@ static u32 tb3_keys(void)
 	return ~din & (TB3_KEY_VOLUP | TB3_KEY_VOLDOWN);
 }
 
+static bool tb3_power_key(void)
+{
+	u16 sta;
+
+	if (pmic_read(MT6323_CHRSTATUS, &sta))
+		return false;
+
+	return !(sta & MT6323_PWRKEY_DEB);
+}
+
+/*
+ * "tb3keys" input device: a power key press reads as Ctrl-C, which ends
+ * "fastboot usb" and "ums". A press only counts after the key has been seen
+ * released, so the press that selected a menu entry does not end it.
+ */
+static bool tb3keys_armed;
+static ulong tb3keys_last;
+
+static int tb3keys_tstc(struct stdio_dev *dev)
+{
+	/* polled in USB loops: keep the PMIC traffic low */
+	if (get_timer(tb3keys_last) < 20)
+		return 0;
+	tb3keys_last = get_timer(0);
+
+	if (!tb3_power_key()) {
+		tb3keys_armed = true;
+		return 0;
+	}
+
+	return tb3keys_armed;
+}
+
+static int tb3keys_getc(struct stdio_dev *dev)
+{
+	tb3keys_armed = false;
+
+	return 0x03;
+}
 static bool tb3_take_reboot_flag(void)
 {
 	u32 *flag = (u32 *)TB3_REBOOT_FLAG;
@@ -367,14 +428,20 @@ int board_late_init(void)
 	env_set("fastboot.uboot-log", "fastboot oem console");
 
 	/* Give the user a window to press a key: LK hands over quickly. */
-	printf("Hold Volume-Down for fastboot, Volume-Up for recovery...\n");
+	printf("Volume-Down: boot menu, Volume-Up: recovery. Booting in");
 	start = get_timer(0);
+	i = -1;
 	do {
 		keys = tb3_keys();
 		if (keys)
 			break;
+		if (get_timer(start) / 1000 != i) {
+			i = get_timer(start) / 1000;
+			printf(" %d", TB3_KEY_WINDOW_MS / 1000 - i);
+		}
 		mdelay(20);
 	} while (get_timer(start) < TB3_KEY_WINDOW_MS);
+	printf("\n");
 	env_set("fastboot.keys", keys & TB3_KEY_VOLDOWN ? "volume-down" :
 		keys & TB3_KEY_VOLUP ? "volume-up" : "none");
 
@@ -389,7 +456,7 @@ int board_late_init(void)
 		env_set("tb3_mode", "fastboot");
 		env_set("fastboot.boot_path", "reboot-bootloader");
 	} else if (keys & TB3_KEY_VOLDOWN) {
-		env_set("tb3_mode", "fastboot");
+		env_set("tb3_mode", "menu");
 		env_set("fastboot.boot_path", "volume-down");
 	}
 
@@ -408,6 +475,119 @@ void board_prep_linux(struct bootm_headers *images)
 		printf("Boot-once guard: disarmed (RTC PDN1 0x%04x)\n", pdn1);
 }
 
+/* Boot menu: Volume-Up/Down move, the power key selects. */
+static const struct {
+	const char *label;
+	const char *cmd;
+} tb3_menu[] = {
+	{ "Fastboot (USB)", "run fastboot_mode" },
+	{ "USB disk: userdata", "run ums_mode" },
+	{ "Recovery (TWRP)", "bootmode recovery; reset" },
+	{ "LK fastboot", "bootmode fastboot; reset" },
+	{ "Continue boot", NULL },
+};
+
+#define TB3_KEY_POWER		BIT(31)
+
+static u32 tb3_all_keys(void)
+{
+	return tb3_keys() | (tb3_power_key() ? TB3_KEY_POWER : 0);
+}
+
+/* Next key press, debounced; returns once all keys were released before. */
+static u32 tb3_wait_key(void)
+{
+	u32 k;
+
+	while (tb3_all_keys())
+		mdelay(10);
+	for (;;) {
+		k = tb3_all_keys();
+		if (k) {
+			mdelay(30);
+			if (tb3_all_keys() == k)
+				return k;
+		}
+		mdelay(10);
+	}
+}
+
+static void tb3_menu_draw(int sel)
+{
+	int i;
+
+	printf("\e[2J\e[1;1H\n  TB3-710F U-Boot menu\n\n");
+	for (i = 0; i < ARRAY_SIZE(tb3_menu); i++)
+		printf("  %s %-24s \e[0m\n", i == sel ? "\e[7m>" : " ",
+		       tb3_menu[i].label);
+	printf("\n  Volume-Up/Down: move   Power: select\n");
+}
+
+static int do_tb3menu(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	int sel = 0;
+	u32 k;
+
+	/* The guard would send a reset during a long menu wait to recovery */
+	tb3_set_bootmode(TB3_BOOT_NORMAL, NULL);
+	for (;;) {
+		tb3_menu_draw(sel);
+		k = tb3_wait_key();
+		if (k & TB3_KEY_VOLUP)
+			sel = (sel + ARRAY_SIZE(tb3_menu) - 1) % ARRAY_SIZE(tb3_menu);
+		else if (k & TB3_KEY_VOLDOWN)
+			sel = (sel + 1) % ARRAY_SIZE(tb3_menu);
+		else if (k & TB3_KEY_POWER) {
+			if (!tb3_menu[sel].cmd)
+				break;
+			printf("\e[2J\e[1;1H");
+			run_command_list(tb3_menu[sel].cmd, -1, 0);
+		}
+	}
+	printf("\e[2J\e[1;1H");
+	tb3_set_bootmode(TB3_BOOT_RECOVERY, NULL);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(tb3menu, 1, 0, do_tb3menu,
+	   "boot menu driven by the volume and power keys", "");
+
+/* "fastboot oem board:ums" leaves fastboot for the USB disk mode */
+static struct cyclic_info tb3_detach_cyclic;
+
+static void tb3_detach(struct cyclic_info *c)
+{
+	cyclic_unregister(c);
+	g_dnl_trigger_detach();
+}
+
+void fastboot_oem_board(char *cmd_parameter, void *data, u32 size,
+			char *response)
+{
+	if (cmd_parameter && !strcmp(cmd_parameter, "ums")) {
+		env_set("tb3_next", "ums");
+		/* after the response has reached the host */
+		cyclic_register(&tb3_detach_cyclic, tb3_detach, 200000,
+				"tb3_detach");
+		fastboot_okay(NULL, response);
+		return;
+	}
+	fastboot_fail("unknown oem board command (ums)", response);
+}
+
+/* The USB disk mode identifies as the Linux mass storage gadget */
+int g_dnl_bind_fixup(struct usb_device_descriptor *dev, const char *name)
+{
+	if (!strcmp(name, "usb_dnl_ums")) {
+		dev->idVendor = cpu_to_le16(0x0525);
+		dev->idProduct = cpu_to_le16(0xa4a5);
+	}
+
+	return 0;
+}
+
 static int do_tb3_bootmode(struct cmd_tbl *cmdtp, int flag, int argc,
 			   char *const argv[])
 {
diff --git a/board/lenovo/tb3-710f/tb3-710f.env b/board/lenovo/tb3-710f/tb3-710f.env
index 76a39f5b545..b15f95afc20 100644
--- a/board/lenovo/tb3-710f/tb3-710f.env
+++ b/board/lenovo/tb3-710f/tb3-710f.env
@@ -52,12 +52,30 @@ boot_failed=echo == Nothing to boot;
 board=tb3-710f-uboot
 fastboot_raw_partition_boot=0xec00 0x8000
 fastboot_raw_partition_userdata=0x465000 0xa21a00
-fastboot_mode=bootmode normal;
-	echo; echo ======== U-Boot fastboot mode (${fastboot.boot_path}) ========;
+/*
+ * The power key reads as Ctrl-C while stdin includes tb3keys: it ends
+ * "fastboot usb" and "ums". "fastboot oem board:ums" switches from fastboot
+ * to the USB disk mode and back.
+ */
+fastboot_banner=echo; echo ======== U-Boot fastboot mode (${fastboot.boot_path}) ========;
 	echo fastboot -s ${serial#} getvar product = ${board};
-	echo flash boot / userdata, boot, oem console, continue, reboot;
+	echo flash boot / userdata, boot, oem console, oem board:ums, continue, reboot;
 	echo reboot-bootloader: here again, reboot-recovery: TWRP, reboot-fastboot: LK fastboot;
-	fastboot usb 0; bootmode recovery
+	echo Power key: leave fastboot
+fastboot_mode=bootmode normal; setenv stdin nulldev,tb3keys; setenv tb3_next fastboot;
+	while test "${tb3_next}" != done; do
+	if test "${tb3_next}" = ums; then run ums_session; fi;
+	setenv tb3_next done; run fastboot_banner; fastboot usb 0; done;
+	setenv stdin nulldev; bootmode recovery
+
+/* USB disk: userdata up to the BMT pool (mmcblk0p7, 10623488 blocks) */
+ums_session=echo; echo ======== USB disk: userdata (mmc 0 blocks 4608000 + 10623488) ========;
+	echo Power key: leave the USB disk mode;
+	blkmap create userdata && blkmap map userdata 0 0xa21a00 linear mmc 0 0x465000 &&
+	blkmap get userdata dev ums_dev && ums 0 blkmap ${ums_dev}; blkmap destroy userdata
+ums_mode=bootmode normal; setenv stdin nulldev,tb3keys; run ums_session;
+	setenv stdin nulldev; bootmode recovery
 
-bootcmd=if test "${tb3_mode}" = fastboot; then run fastboot_mode; fi;
+bootcmd=if test "${tb3_mode}" = menu; then tb3menu; fi;
+	if test "${tb3_mode}" = fastboot; then run fastboot_mode; fi;
 	run nerves_map; run boot_nerves; run boot_buildroot; run boot_failed
diff --git a/configs/mt8127_tb3_710f_defconfig b/configs/mt8127_tb3_710f_defconfig
index 385785ca62c..7e31a7bfebf 100644
--- a/configs/mt8127_tb3_710f_defconfig
+++ b/configs/mt8127_tb3_710f_defconfig
@@ -30,6 +30,7 @@ CONFIG_SYS_PROMPT="tb3=> "
 CONFIG_CMD_BOOTZ=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_PART=y
+CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_WDT=y
 CONFIG_CMD_CACHE=y
 CONFIG_CMD_SYSBOOT=y
@@ -46,6 +47,7 @@ CONFIG_FASTBOOT_FLASH=y
 CONFIG_FASTBOOT_FLASH_MMC_DEV=0
 CONFIG_FASTBOOT_MMC_RAW_PARTITIONS_ONLY=y
 CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
+CONFIG_FASTBOOT_OEM_BOARD=y
 CONFIG_MMC_MTK=y
 # CONFIG_REQUIRE_SERIAL_CONSOLE is not set
 CONFIG_DM_SERIAL=y
@@ -58,6 +60,7 @@ CONFIG_USB_GADGET=y
 CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
 CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee0
 CONFIG_VIDEO=y
+CONFIG_VIDEO_ANSI=y
 CONFIG_SYS_WHITE_ON_BLACK=y
 CONFIG_VIDEO_SIMPLE=y
 CONFIG_WDT_MTK=y
