diff --git a/arch/arm/mach-mediatek/mt8127/init.c b/arch/arm/mach-mediatek/mt8127/init.c
new file mode 100644
index 00000000000..a2d4fb7be5e
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt8127/init.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT8127 support for U-Boot running as a second stage after the
+ * vendor LK bootloader: DRAM, clocks and the PMIC wrapper are already set up.
+ */
+
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/*
+ * Keep U-Boot (relocated code, heap, stack) below the regions Linux reserves
+ * at the top of DRAM: CONSYS shared memory at 0xbc000000 and the ramoops
+ * buffer at 0xbd000000.
+ */
+#define MT8127_USABLE_RAM_TOP	0xbc000000
+
+/*
+ * The ARM generic timer counter only runs while GPT6 is enabled: it ungates
+ * the arch timer clocks. The vendor boot chain leaves it off.
+ */
+#define MT8127_GPT6_CON		0x10008060
+#define MT8127_GPT_ENABLE_FREERUN	0x31
+
+int mach_cpu_init(void)
+{
+	writel(MT8127_GPT_ENABLE_FREERUN, MT8127_GPT6_CON);
+
+	return 0;
+}
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	phys_addr_t top = gd->ram_base + gd->ram_size;
+
+	return min_t(phys_addr_t, top, MT8127_USABLE_RAM_TOP);
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   MediaTek MT8127\n");
+
+	return 0;
+}
diff --git a/include/configs/mt8127.h b/include/configs/mt8127.h
new file mode 100644
index 00000000000..7e73bcb3265
--- /dev/null
+++ b/include/configs/mt8127.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Configuration for MediaTek MT8127 SoC
+ */
+
+#ifndef __MT8127_H
+#define __MT8127_H
+
+/* DRAM */
+#define CFG_SYS_SDRAM_BASE		0x80000000
+
+/*
+ * The vendor boot chain does not program CNTFRQ (the Linux device tree marks
+ * the timer "arm,cpu-registers-not-fw-configured"); the counter runs at the
+ * 13 MHz system clock.
+ */
+#define CFG_SYS_HZ_CLOCK		13000000
+
+#endif
