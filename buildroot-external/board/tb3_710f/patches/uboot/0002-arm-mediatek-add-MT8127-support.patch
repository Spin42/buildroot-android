index 35f748a70d6..7fc99da5391 100644
--- a/arch/arm/mach-mediatek/Makefile
+++ b/arch/arm/mach-mediatek/Makefile
@@ -8,6 +8,7 @@ obj-$(CONFIG_XPL_BUILD)	+= spl.o
 obj-$(CONFIG_TARGET_MT7622) += mt7622/
