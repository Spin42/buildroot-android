--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -29,6 +29,16 @@ config TARGET_MT7623
 	  Peripherals include Gigabit Ethernet, switch, USB3.0 and OTG, PCIe,
 	  I2S, PCM, S/PDIF, UART, SPI, I2C, IR TX/RX, and PWM.
 
+config TARGET_MT8127
+	bool "MediaTek MT8127 SoC"
+	select CPU_V7A
+	select SYS_ARCH_TIMER
+	help
+	  The MediaTek MT8127 is an ARM-based tablet SoC with a quad-core
+	  Cortex-A7 and a Mali-450 GPU. U-Boot runs as a second stage loaded
+	  by the vendor LK bootloader, which has already set up DRAM, clocks,
+	  the PMIC wrapper and the display.
+
 config TARGET_MT7629
 	bool "MediaTek MT7629 SoC"
 	select CPU_V7A
@@ -197,6 +207,7 @@ config SYS_BOARD
 config SYS_CONFIG_NAME
 	default "mt7623" if TARGET_MT7623
 	default "mt7629" if TARGET_MT7629
+	default "mt8127" if TARGET_MT8127
 	default "mt7981" if TARGET_MT7981
 	default "mt7986" if TARGET_MT7986
 	default "mt8183" if TARGET_MT8183
