#!/bin/sh
#
# S28hexagonfs - Mount Android partitions and populate HexagonFS
#
# This must run BEFORE pd-mapper (S30), tqftpserv (S31) and hexagonrpcd (S32)
# so that the ADSP has access to firmware files, DSP libraries, ACDB data,
# and sensor configuration when it boots.
#
# Board-specific configuration is read from /etc/hexagonfs.conf which is
# provided by the board overlay.
#

CONF="/etc/hexagonfs.conf"

if [ ! -f "$CONF" ]; then
	echo "S28hexagonfs: $CONF not found, skipping"
	exit 0
fi

. "$CONF"

populate_socinfo() {
	local socdir="$HEXFS/socinfo"
	mkdir -p "$socdir"
	for f in soc_id revision serial_number machine family \
		 pmic_model pmic_die_revision hw_platform \
		 platform_version platform_subtype; do
		if [ -f "/sys/devices/soc0/$f" ]; then
			cp "/sys/devices/soc0/$f" "$socdir/$f"
		fi
	done

	# Mainline kernel doesn't expose hw_platform or platform_subtype
	# via sysfs. The ADSP firmware may need these to determine sensor
	# configuration.
	if [ ! -f "$socdir/hw_platform" ]; then
		echo "${HW_PLATFORM:-MTP}" > "$socdir/hw_platform"
	fi
	if [ ! -f "$socdir/platform_subtype" ]; then
		echo "Unknown" > "$socdir/platform_subtype"
	fi
	if [ ! -f "$socdir/platform_version" ]; then
		echo "0" > "$socdir/platform_version"
	fi
}

populate_acdb() {
	# Skip if acdb files are already installed (e.g. by firmware package)
	if [ -d "$HEXFS/acdb" ] && [ "$(ls -A "$HEXFS/acdb" 2>/dev/null)" ]; then
		return
	fi
	# Fall back to runtime copy from vendor partition
	if [ -n "$VENDOR_ROOT" ] && [ -d "$VENDOR_ROOT/etc/acdbdata" ]; then
		mkdir -p "$HEXFS/acdb"
		cp -a "$VENDOR_ROOT/etc/acdbdata"/* "$HEXFS/acdb/" 2>/dev/null
	fi
}

populate_dsp() {
	local src="$MNT_DSP"
	local dst="$HEXFS/dsp/adsp"
	if [ -d "$src" ]; then
		mkdir -p "$dst"
		cp -a "$src"/* "$dst/" 2>/dev/null
	fi
}

populate_sensors() {
	local dst="$HEXFS/sensors"
	mkdir -p "$dst/config" "$dst/registry"

	# sensors/config/ — skip if already populated (e.g. by board overlay)
	if [ ! "$(ls -A "$dst/config" 2>/dev/null)" ]; then
		if [ -n "$VENDOR_ROOT" ] && [ -d "$VENDOR_ROOT/etc/sensors" ]; then
			for f in "$VENDOR_ROOT/etc/sensors"/*; do
				[ -f "$f" ] && cp "$f" "$dst/config/" 2>/dev/null
			done
		fi
	fi

	# sensors/registry/ — from persist (always runtime)
	if [ -d "$MNT_PERSIST/sensors" ]; then
		cp -a "$MNT_PERSIST/sensors"/* "$dst/registry/" 2>/dev/null
	fi

	# sensors/sns_reg.conf — registry config file
	if [ ! -f "$dst/sns_reg.conf" ]; then
		touch "$dst/sns_reg.conf"
	fi
}

start() {
	printf 'Populating HexagonFS: '

	# Mount Android partitions (read-only)
	mkdir -p "$MNT_PERSIST" "$MNT_DSP"

	if [ -n "$DEV_VENDOR" ]; then
		mkdir -p "$MNT_VENDOR"
		mount -o ro "$DEV_VENDOR" "$MNT_VENDOR" 2>/dev/null
	fi
	if [ -n "$DEV_SYSTEM" ]; then
		mkdir -p "$MNT_SYSTEM"
		mount -o ro "$DEV_SYSTEM" "$MNT_SYSTEM" 2>/dev/null
	fi
	mount -t ext4 -o ro "$DEV_PERSIST" "$MNT_PERSIST" 2>/dev/null
	mount -o ro "$DEV_DSP" "$MNT_DSP" 2>/dev/null

	# Create HexagonFS directory structure
	mkdir -p "$HEXFS"

	populate_socinfo
	populate_acdb
	populate_dsp
	populate_sensors

	echo "OK"
}

stop() {
	printf 'Cleaning up HexagonFS: '
	# Only remove runtime-populated dirs; firmware-installed files
	# (acdb, sensors/config) are part of the rootfs and should stay.
	rm -rf "$HEXFS/socinfo" "$HEXFS/dsp" "$HEXFS/sensors/registry"
	umount "$MNT_DSP" 2>/dev/null
	umount "$MNT_PERSIST" 2>/dev/null
	[ -n "$MNT_VENDOR" ] && umount "$MNT_VENDOR" 2>/dev/null
	[ -n "$MNT_SYSTEM" ] && umount "$MNT_SYSTEM" 2>/dev/null
	echo "OK"
}

restart() {
	stop
	start
}

case "$1" in
	start|stop|restart)
		"$1";;
	reload)
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
