config BR2_PACKAGE_MT8127_BT
	bool "mt8127-bt"
	depends on BR2_LINUX_KERNEL
	select BR2_LINUX_NEEDS_MODULES
	select BR2_PACKAGE_MT8127_WMT
	select BR2_PACKAGE_MT8127_CONSYS
	help
	  Bluetooth HCI driver (mtk_consys_bt) for the MT8127 CONSYS, on
	  top of the WMT core. Registers hci0 for BlueZ. Needs the
	  CONFIG_BT kernel options and the CONSYS firmware (tb3-firmware).
