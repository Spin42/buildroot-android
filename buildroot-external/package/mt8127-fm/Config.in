config BR2_PACKAGE_MT8127_FM
	bool "mt8127-fm"
	depends on BR2_LINUX_KERNEL
	select BR2_LINUX_NEEDS_MODULES
	select BR2_PACKAGE_MT8127_WMT
	select BR2_PACKAGE_MT8127_CONSYS
	help
	  FM radio driver (mtk_consys_fm, a V4L2 radio device) for the
	  MT8127 CONSYS, on top of the WMT core, and the fm-radio
	  control tool. Needs the MT6627 FM firmware (tb3-firmware).
