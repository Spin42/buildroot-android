config BR2_PACKAGE_MT8127_CONSYS
	bool "mt8127-consys"
	depends on BR2_LINUX_KERNEL
	select BR2_LINUX_NEEDS_MODULES
	help
	  Platform support for the MT8127 CONSYS connectivity subsystem:
	  PMIC rails, power domain, clock gate, reserved memory and the
	  interrupts of the block. Provides the platform functions the WMT
	  core expects.
