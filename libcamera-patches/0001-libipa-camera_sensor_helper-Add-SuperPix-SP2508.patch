From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Sun, 11 Oct 2026 09:13:14 +0200
Subject: [PATCH 1/3] libipa: camera_sensor_helper: Add SuperPix SP2508

The SP2508 analogue gain register is linear in units of 1/16, 0x10
being unity gain.

Assisted-by: Claude:claude-opus-5-5
---
 src/ipa/libipa/camera_sensor_helper.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 7c66cd5..b6c696b 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -745,6 +745,20 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperSp2508 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperSp2508()
+	{
+		/*
+		 * The gain register holds the analogue gain in units of 1/16
+		 * (0x10 is 1x), as programmed by the vendor driver.
+		 */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("sp2508", CameraSensorHelperSp2508)
+
 #endif /* __DOXYGEN__ */
 
 } /* namespace ipa */
